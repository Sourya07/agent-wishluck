# ---------------------------------------------------------------------------
# Wishluck Order Ops & Support Agent — copy to backend/.env (local) or ./.env (Docker)
# Never commit real keys.
# ---------------------------------------------------------------------------

PORT=4000
# Where customer-facing links (tracking, payment) point. Local dev: Vite on 5173. Docker: http://localhost:4000
FRONTEND_URL=http://localhost:5173
# SQLite file (created + seeded on first start). Use :memory: for throwaway runs.
DB_PATH=./data/wishluck.db
# Set to use BullMQ (Redis). Leave empty to use the built-in durable SQLite queue.
REDIS_URL=

# --- LLM (tool calling). Leave LLM_PROVIDER=none to run the deterministic rule-based agent.
# openai | anthropic | gemini | groq | openrouter | ollama | none
LLM_PROVIDER=none
LLM_API_KEY=
# Optional overrides (sensible defaults per provider: gpt-4o-mini, claude-3-5-haiku-latest, gemini-2.0-flash, llama-3.3-70b-versatile)
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2
# USD per 1M tokens, only if the built-in price table doesn't know your model
LLM_PRICE_IN=
LLM_PRICE_OUT=

# --- Webhook secrets (HMAC-SHA256)
ORDER_WEBHOOK_SECRET=change-me-order-secret
COURIER_WEBHOOK_SECRET=change-me-courier-secret
# Shopify app "API secret key" (X-Shopify-Hmac-Sha256), optional
SHOPIFY_WEBHOOK_SECRET=

# --- Optional: protect the internal dashboard API with a shared token (also set VITE_DASHBOARD_TOKEN for the frontend build)
DASHBOARD_TOKEN=

# --- Optional: WhatsApp Cloud API (test number)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=wishluck-verify
WHATSAPP_APP_SECRET=

LOG_LEVEL=info
